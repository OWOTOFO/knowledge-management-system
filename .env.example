# You normally don't need this file: the web page's Settings tab writes .env for you.
# ---- Provider selection -------------------------------------------------
# mock | azure_openai | openai | openrouter | bedrock
LLM_PROVIDER=mock
# Optional: use a different provider for embeddings (defaults to LLM_PROVIDER)
# EMBEDDING_PROVIDER=azure_openai
# Reasoning models (o-series, GPT-5 family) reject temperature: set LLM_TEMPERATURE=none
LLM_TEMPERATURE=0

# ---- Azure OpenAI (primary target for an enterprise/bank deployment) ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Leave the key empty to authenticate with Entra ID (DefaultAzureCredential / managed identity)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---- OpenAI or an OpenAI-compatible gateway -----------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://llm-gateway.internal.example/v1
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- OpenRouter (LLM_PROVIDER=openrouter; one key for chat and embeddings) ----
# Key: https://openrouter.ai/settings/keys. Model ids look like deepseek/deepseek-v4.1-flash-1017 or openai/gpt-4.1.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# ---- AWS Bedrock (uses the standard AWS credential chain) ----------------
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ---- Pipeline tuning -----------------------------------------------------
TOP_K=12
DOC_MIN_SIMILARITY=0.35
DOC_MIN_COVERAGE=0.5
ROUTER_MIN_CONFIDENCE=0.6
GROUNDEDNESS_THRESHOLD=0.8
SQL_MAX_ROWS=50
